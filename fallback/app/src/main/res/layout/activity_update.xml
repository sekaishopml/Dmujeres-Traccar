<?xml version="1.0" encoding="utf-8"?>
<!-- Actualización OTA: logo, avance y estado, con el contenido hacia el
     35-40% de la pantalla (los pesos reparten el aire de arriba y abajo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1" />

    <ImageView
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_logo"
        android:src="@drawable/logo_banner" />

    <ProgressBar
        android:id="@+id/update_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:indeterminateTint="@color/primary" />

    <TextView
        android:id="@+id/update_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/update_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/update_downloading"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <Button
        android:id="@+id/update_retry"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_button_soft"
        android:minWidth="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/update_retry"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9" />

</LinearLayout>
