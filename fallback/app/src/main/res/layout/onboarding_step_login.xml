<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_login_title"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/onboarding_login_user"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/field_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:enabled="false"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/onboarding_login_pass"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/field_pass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:enabled="false"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/url_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/onboarding_login_url"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/field_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/onboarding_login_hint"
        android:textColor="@color/muted"
        android:textSize="12sp" />

</LinearLayout>