# Copia a mobile/keystore.properties (0600, gitignored) y apunta a la clave
# del canal OTA. La flota instalada (<=1.1.2) usa la clave debug compartida
# versionada (../keystore/debug.keystore); NO cambiar de clave sin migracion
# coordinada o los equipos no podran actualizar (INSTALL_FAILED_UPDATE_INCOMPATIBLE).
# Ver docs/SECURITY_BUILD.md.
storeFile=../keystore/debug.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
