<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_body"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/stepLocationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_location"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/stepLocationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_location"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/stepNotificationsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_notifications"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/stepNotificationsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_notifications"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/stepBatteryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_battery"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/stepBatteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_battery"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/stepGpsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_gps"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/stepGpsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_gps"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/finishButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/finish"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>
