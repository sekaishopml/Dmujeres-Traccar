<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de jornada 2x2 (RemoteViews puro = máxima compatibilidad de launchers).
  Vertical en tres franjas bien repartidas: header (logo + nombre) arriba,
  ESTADO grande y subtítulo centrados en el espacio libre (weight 1), botón
  píldora anclado abajo. Nada queda pegado a un borde ni agrupado arriba.
  Solo vistas soportadas por RemoteViews: LinearLayout/TextView/ImageView.
  El fondo del botón se cambia por código (verde/rojo).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="110dp"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/widget_label" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="#181818"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="@string/app_name" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="#181818"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="@string/widget_idle" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:text="@string/widget_waiting" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:background="@drawable/widget_button_verde"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="@string/action_start" />

</LinearLayout>
