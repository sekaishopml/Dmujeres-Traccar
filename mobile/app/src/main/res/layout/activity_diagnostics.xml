<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_banner"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/primary"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/diagGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="#666666"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/diagTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_test"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/diagPermissionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_button" />

    </LinearLayout>
</ScrollView>
