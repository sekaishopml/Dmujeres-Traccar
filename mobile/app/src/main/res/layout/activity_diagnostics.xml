<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/diag_title"
            app:titleTextColor="@color/ink"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/diagState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagLastFix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagLastAck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:padding="12dp"
            android:background="@drawable/state_background"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/diagDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="#666666"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/diagTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_test"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/diagRecoverButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_retry_service"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/diagPermissionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_button" />

    </LinearLayout>
</ScrollView>
