# .env.example — secretos y configuración del proyecto
# Copiar a .env (gitignored) antes de levantar cualquier servicio.

# Base de datos PostgreSQL / TimescaleDB
POSTGRES_DB=traccar
POSTGRES_USER=traccar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_DRIVER=org.postgresql.Driver
# Dev (server en host):  jdbc:postgresql://localhost:5433/traccar (5433 externo; 5432 ocupado por otro proyecto)
# Prod (todo en compose): jdbc:postgresql://database:5432/traccar
DATABASE_URL=jdbc:postgresql://localhost:5433/traccar
CONFIG_DATABASE_MAXPOOLSIZE=20

# --- Server Traccar ---
SERVER_WEB_PORT=8082
SERVER_ADDRESS=0.0.0.0
CONFIG_WEB_EXTERNALADDRESS=http://localhost:8082

# --- Redis (broadcast / cachés; usado si se habilita) ---
CONFIG_REDIS_URL=redis://localhost:6379/0

# --- MQTT (broker EMQX en dev) ---
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=

# --- Mobile MQTT consumer ---
MOBILE_MQTT_ENABLE=true
MOBILE_MQTT_URL=mqtt://localhost:1883
MOBILE_MQTT_TOPIC=dmj/v1/devices/+/telemetry
MOBILE_MQTT_ACK_TOPIC=dmj/v1/devices/{deviceId}/ack
MOBILE_MQTT_CLIENT_ID=dmj-traccar-consumer
# Credenciales del cliente MQTT del server (usuario dmj-consumer en auth-file.csv).
# El password por defecto es SOLO dev; si auth-file.csv se regenera, poner aquí
# el nuevo (generar: ./infrastructure/scripts/mqtt-users.sh hash '<pass>').
MOBILE_MQTT_USERNAME=dmj-consumer
MOBILE_MQTT_PASSWORD=dmj-consumer-dev-pass
MOBILE_MQTT_MAX_PAYLOAD=65536
MOBILE_MQTT_WORKER_QUEUE=256
MOBILE_MQTT_LEASE_SECONDS=60

# --- Mobile HTTP fallback (mismo envelope/idempotencia que MQTT) ---
MOBILE_HTTP_ENABLE=true
MOBILE_HTTP_API_KEY=dmj-dev-fallback-key

# --- Google Maps / proveedores de mapa (OPCIONAL, solo con key legítima) ---
GOOGLE_MAPS_KEY=
MAPTILER_KEY=
BING_MAPS_KEY=

# --- Dashboard ---
DASHBOARD_URL=http://localhost:8082

# --- Seguridad ---
# Token de firma de sessions (generar con: openssl rand -hex 32)
WEB_SECRET_TOKEN=CHANGE_ME_RANDOM_HEX
# Clave de cifrado para secrets (openssl rand -base64 32)
ENCRYPTION_KEY=CHANGE_ME_BASE64

# --- Backups ---
BACKUP_DIR=/var/backups/dmj
BACKUP_RETENTION_DAYS=30

# --- Composición (qué compose usa dev.sh/backup.sh/restore.sh/migrate.sh) ---
# Dev:   infrastructure/compose/docker-compose.yml
# Prod:  infrastructure/compose/docker-compose.prod.yml
COMPOSE_FILE=infrastructure/compose/docker-compose.yml

# --- EMQX (dev) ---
# Password del dashboard admin de EMQX (dev bindea 127.0.0.1; NO exponer 18083)
EMQX_DASHBOARD_PASSWORD=public
# URL base del dashboard API para scripts de gestión de usuarios MQTT
# (mqtt-users.sh). Dev usa http://127.0.0.1:18083.
EMQX_API_URL=http://127.0.0.1:18083
# API key de EMQX (recomendado; si se omite, mqtt-users.sh cae a admin/public con
# AVISO). Crear en Dashboard -> System -> API Keys. Formato: key + secret.
# EMQX_API_KEY=
# EMQX_API_SECRET=

# --- Producción (docker-compose.prod.yml) ---
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG
# Credenciales MQTT (authN de EMQX): los usuarios se gestionan con
# infrastructure/scripts/mqtt-users.sh (add) o el bootstrap auth-file.csv.
# La API añade el password directamente; no se guarda plaintext en este .env.
# MQTT_USER=dmj-app   # (ya no usado: EMQX 5.8 no acepta EMQX_AUTHENTICATION__1__USERNAME)
# MQTT_PASSWORD=CHANGE_ME_MQTT_STRONG
# --- TLS de EMQX (prod): rutas de certs PEM montadas (secretos NO versionados) ---
# Directorio host con los certs (se monta en /opt/emqx/certs).
#   Ejemplo certbot: EMQX_CERTS_DIR=/etc/letsencrypt/live/mqtt.dmujeres.example
EMQX_CERTS_DIR=./emqx-certs
EMQX_CERTFILE=/opt/emqx/certs/tls.crt
EMQX_KEYFILE=/opt/emqx/certs/tls.key
# EMQX_CACERTFILE=/opt/emqx/certs/ca.crt   # opcional (cadena separada o mTLS)

# --- EMQX (prod) authN/authZ: archivos montados (sobrescribir templates) ---
# En producción NO usar infrastructure/emqx/auth-file.csv (credenciales de ejemplo).
# Generar un archivo real (mqtt-users.sh hash / add) y apuntarlo aquí, sin versionarlo:
#   EMQX_AUTH_FILE=/etc/dmj-emqx/auth-file.csv
#   EMQX_ACL_FILE=/etc/dmj-emqx/acl-file.conf
# (si no se definen, se montan los templates del repo: infrastructure/emqx/.)

# --- Dashboard admin (para create-collaborator.sh) ---
DASH_URL=http://localhost:8082
DASH_ADMIN_EMAIL=admin@dmj.local
DASH_ADMIN_PASSWORD=CHANGE_ME
