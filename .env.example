# DMujeres Tracking - ejemplo de variables de entorno
# Copiar a .env (desarrollo) o usar como plantilla del EnvironmentFile de systemd.
# NO contiene valores reales ni secretos.

DMJ_ENTORNO=desarrollo
DMJ_WEB_PORT=8080
DMJ_API_PORT=3001
DMJ_TRACKING_PORT=5055

DMJ_DB_URL=postgresql://127.0.0.1:5432/dmj_tracking
DMJ_DB_USUARIO=dmj_api
DMJ_DB_CLAVE=clave-de-ejemplo

DMJ_SESION_HORAS=12

DMJ_TLS_CERT=/etc/dmj/tls/sitio.crt
DMJ_TLS_KEY=/etc/dmj/tls/sitio.key
DMJ_TLS_DOMINIO=tracking.ejemplo.invalid

# Transición: lectura del sistema actual (se retira tras el cutover).
DMJ_LEGADO_TRACCAR_URL=http://127.0.0.1:999
