[Unit]
Description=DMujeres Tracking panel nuevo (sirve apps/panel/dist y proxya /api a services/api)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=opencode
Group=opencode
WorkingDirectory=/home/DMujeres-Tracking/services/web
EnvironmentFile=/home/DMujeres-Tracking/.env
Environment=DMJ_WEB_HOST=0.0.0.0
Environment=DMJ_WEB_PORT=8999
Environment=DMJ_WEB_DIST=/home/DMujeres-Tracking/apps/panel/dist
ExecStart=/usr/local/bin/node24 src/servidor.js
Restart=always
RestartSec=3
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
