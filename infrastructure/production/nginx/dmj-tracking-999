# DMujeres Tracking - puerta publica del puerto 999 que usaba el panel viejo.
# La App deriva este puerto desde su URL :5055, asi que aqui se atiende el
# canal movil con la plataforma nueva:
#   /api/mobile/*  -> services/tracking (OsmAnd y canal movil)
#   /api/*         -> services/web (que a su vez proxya a services/api)
#   /              -> panel nuevo (services/web)
#   OTA            -> manifiesto y APK servidos desde /home/DMujeres-Tracking/ota
server {
    listen 999;
    listen [::]:999;
    server_name _;

    client_max_body_size 10m;

    # OTA: lo que consulta la App para actualizarse
    location = /latest.json { root /home/DMujeres-Tracking/ota; }
    location = /rollout.json { root /home/DMujeres-Tracking/ota; }
    location ~ ^/DMujeres-Tracking-[0-9.]+\.apk$ { root /home/DMujeres-Tracking/ota; }

    # Canal movil de la App (config, journey, diagnostics, ota, fcm, recovery)
    location /api/mobile/ {
        proxy_pass http://127.0.0.1:5055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Panel nuevo y API propia (services/web ya proxya /api/* a services/api)
    location / {
        proxy_pass http://127.0.0.1:25565;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
